{
  "name": "promiseguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "test:checker": "node --test --test-isolation=none tests/reliability/check-evidence.test.mjs",
    "test:monitor": "npm run build:server && node --test --test-isolation=none tests/monitoring/*.test.mjs",
    "test:baseline": "node --test --test-isolation=none tests/reliability/*.test.mjs tests/monitoring/*.test.mjs",
    "test:app": "vitest run --project app",
    "test:web": "vitest run --project web",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:baseline && npm run test:app && npm run test:web && npm run test:e2e",
    "monitor": "node dist/server/monitoring/cli.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/openai": "1.5.13",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
