# Local scaffold only. This fixture identity is synthetic, not workflow evidence.
PG_HOST=127.0.0.1
PG_PORT=3000
PG_MODEL_MODE=mock
PG_ADAPTER_MODE=fake
PG_FIXTURE_ID=bootstrap-synthetic-v1

# Separate server-only stores. B01/B04 implement persistence and scheduling.
PG_DATABASE_PATH=.local/application.sqlite
PG_CHECKPOINT_PATH=.local/checkpoints.sqlite
PG_EVIDENCE_DIR=.local/evidence

# Proposed bounded model settings, not live compatibility measurements.
PG_MODEL_TIMEOUT_MS=30000
PG_MODEL_ROLE_BUDGET_MS=90000
PG_MODEL_MAX_ATTEMPTS=2
PG_MODEL_MAX_OUTPUT_TOKENS=2000
PG_MODEL_MAX_INPUT_CHARS=24000
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_ANALYST=
OPENAI_MODEL_DRAFTER=
OPENAI_MODEL_AUDITOR=

# REST requires all four account configurations; readers are optional unless noted.
PG_GITHUB_TOKEN=
PG_GITHUB_REPOSITORY=
PG_GITHUB_READER_TOKEN=
PG_HUBSPOT_ACCESS_TOKEN=
PG_HUBSPOT_PORTAL_ID=
PG_HUBSPOT_READER_TOKEN=
PG_SLACK_BOT_TOKEN=
# Required in REST mode: must retrieve authorized human replies.
PG_SLACK_READER_TOKEN=
PG_SLACK_TEAM_ID=
PG_SLACK_CHANNEL_ID=
# Comma-separated immutable user IDs, without spaces.
PG_SLACK_APPROVER_IDS=
PG_GMAIL_CLIENT_ID=
PG_GMAIL_CLIENT_SECRET=
PG_GMAIL_REFRESH_TOKEN=
PG_GMAIL_MAILBOX=
PG_GMAIL_READER_REFRESH_TOKEN=

# Never use VITE_* for credentials or private account configuration.
# MCP is disabled. Account capabilities are verified by later provider smokes.
